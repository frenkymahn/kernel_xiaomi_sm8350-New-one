# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TEE=y

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Platform
CONFIG_MACH_XIAOMI_VILI=y

# Power Supply
# CONFIG_QTI_BATTERY_CHARGER is not set
CONFIG_QTI_BATTERY_CHARGER_ODIN=y
CONFIG_BQ_FUEL_GAUGE=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# WiFi
CONFIG_CNSS_QCA6490=y

# HyperOS & Port ROM Mount Support

# LocalVersion

# KernelSU Support

# Android 14-17 eBPF & Networking

# Android Binder IPC
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# HyperOS 3.0 / 4.0 Memory & Task Management
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_SCHED_WALT=y

# Android Namespaces & Isolation
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y

# Dynamic Storage & SELinux Security
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_SECURITY_SELINUX=y

# Strict A17 eBPF Loader Flags
CONFIG_NET_CLS_ACT=y
CONFIG_BPF_KPROBE_OVERRIDE=y

# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-NEXTGEN"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_THINLTO=y
CONFIG_POLLY_CLANG=y
# CONFIG_LTO_NONE is not set
CONFIG_ARCH_SUPPORTS_LTO_CLANG=y
CONFIG_ARCH_SUPPORTS_THINLTO=y
CONFIG_CMDLINE="cgroup_disable=pressure"
CONFIG_CMDLINE_EXTEND=y
CONFIG_KSU=y
CONFIG_KSU_KPROBES_HOOK=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_WIREGUARD=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_WESTWOOD=y
CONFIG_DEFAULT_TCP_CONG="westwood"
CONFIG_MILLET_CGROUP=y
CONFIG_MILLET_PKG=y
CONFIG_MILLET_CORE=y
CONFIG_MILLET_HS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW=y
CONFIG_USERFAULTFD=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_CGROUP_FREEZER=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_BPF_STREAM_PARSER=y
# CONFIG_BPF_UNPRIV_DEFAULT_OFF is not set
# CONFIG_F2FS_FS_ZSTD is not set
CONFIG_MSM_CORE_HANG_DETECT=y
CONFIG_QCOM_IPCC=y
