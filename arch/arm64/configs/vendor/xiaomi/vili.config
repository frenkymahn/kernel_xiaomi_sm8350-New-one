# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TEE=y

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Platform
CONFIG_MACH_XIAOMI_VILI=y

# Power Supply
# CONFIG_QTI_BATTERY_CHARGER is not set
CONFIG_QTI_BATTERY_CHARGER_ODIN=y
CONFIG_BQ_FUEL_GAUGE=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# WiFi
CONFIG_CNSS_QCA6490=y

# HyperOS & Port ROM Mount Support
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# LocalVersion
CONFIG_LOCALVERSION="-Next-Gen"

# KernelSU Support
CONFIG_KSU=y

# Android 14-17 eBPF & Networking
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_CGROUP_BPF=y

# Android Binder IPC
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# HyperOS 3.0 / 4.0 Memory & Task Management
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_SCHED_WALT=y

# Android Namespaces & Isolation
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y

# Dynamic Storage & SELinux Security
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_SECURITY_SELINUX=y

# Strict A17 eBPF Loader Flags
CONFIG_BPF_STREAM_PARSER=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_KPROBE_OVERRIDE=y
